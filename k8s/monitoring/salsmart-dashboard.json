{
 "title": "SalSmart ingestion",
 "uid": "salsmart",
 "schemaVersion": 39,
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Prices loaded per chain",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "salsmart_chain_items",
     "legendFormat": "{{chain}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Price changes per run",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "salsmart_chain_price_changes",
     "legendFormat": "{{chain}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Age of newest price file",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - salsmart_chain_newest_file_timestamp_seconds",
     "legendFormat": "{{chain}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Files failed in latest run",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "salsmart_chain_files_failed",
     "legendFormat": "{{chain}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "API requests per minute",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (path) (rate(salsmart_http_requests_total[5m])) * 60",
     "legendFormat": "{{path}}"
    }
   ]
  }
 ]
}